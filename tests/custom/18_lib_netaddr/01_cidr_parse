try {
	netaddr.v4([ 1, 2, 3, 256 ]);
	print("no error\n");
}
catch (e) {
	print("big: ", e.message, "\n");
}

try {
	netaddr.v4([ 1, 2, 3, -1 ]);
	print("no error\n");
}
catch (e) {
	print("neg: ", e.message, "\n");
