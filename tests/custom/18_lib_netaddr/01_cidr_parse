import * as netaddr from 'netaddr';

try {
	netaddr.new("bogus");
	print("no error\n");
}
catch (e) {
	print("new: ", e.message, "\n");
}

try {
	netaddr.v4("2001:db8::1");
	print("no error\n");
}
catch (e) {
	print("IPv4: ", e.message, "\n");
}

try {
	netaddr.v6("1.2.3.4");
	print("no error\n");
}
catch (e) {
	print("IPv6: ", e.message, "\n");
}

try {
	netaddr.mac("1.2.3.4");
	print("no error\n");
}
catch (e) {
	print("MAC: ", e.message, "\n");
}

try {
	netaddr.new("1.2.3.4", 99);
	print("no error\n");
}
catch (e) {
	print("mask: ", e.message, "\n");
}

try {
	netaddr.new("1.2.3.4", "bogus");
	print("no error\n");
}
catch (e) {
	print("maskstr: ", e.message, "\n");
}

try {
	netaddr.new([ 1, 2, 3, 4, 5 ]);
	print("no error\n");
}
catch (e) {
	print("arr5: ", e.message, "\n");
}

try {
	netaddr.new([]);
	print("no error\n");
}
catch (e) {
	print("arr0: ", e.message, "\n");
}

try {
	netaddr.v4([ 0, 11, 22, 33, 44, 55 ]);
	print("no error\n");
}
catch (e) {
	print("v4mac: ", e.message, "\n");
}

try {
	netaddr.v6([ 1, 2, 3, 4 ]);
	print("no error\n");
}
catch (e) {
	print("v6v4: ", e.message, "\n");
