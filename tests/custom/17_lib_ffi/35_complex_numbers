Scale a complex number by a double following it.

-- Testcase --
{%
    import * as ffi from 'ffi';

    if (ffi.C.dlsym('ffi_type_complex_double') == null)
        exit(77);

    let src = TESTFILES_PATH + '/uctestlib.c';
    let so = TESTFILES_PATH + '/uctestlib.so';

    if (system([ 'cc', '-shared', '-fPIC', '-o', so, src ]) != 0)
        exit(77);

    let lib = ffi.dlopen(so, false, `
        double complex uctest_compl_scale(double complex z, double s);
    `);

    // A double following a complex number is only found where the ABI puts it
    // when the complex argument is described by its predefined type.
    print("scaled: ", lib.uctest_compl_scale([1.5, -2.5], 2.0), "\n");
%}
-- End --

-- File uctestlib.c --
double _Complex
uctest_compl_scale(double _Complex z, double s)
{
	double _Complex r;

	__real__ r = __real__ z * s;
	__imag__ r = __imag__ z * s;

	return r;
}
-- End --

-- Expect stdout --
scaled: [ 3.0, -5.0 ]
-- End --
