A dynamically loaded module whose body raises an exception is not stored in
the module table. A later load runs the module again and does not return
the incomplete namespace of the failed load.

-- Testcase --
function run(label, fn) {
	try {
		print(label, ": ", fn(), "\n");
	}
	catch (e) {
		print(label, ": ", e.message, "\n");
	}
}

global.fail = true;
run("failed load #1", () => keys(import("failing")));
run("failed load #2", () => keys(import("failing")));

global.fail = false;
run("good load", () => keys(import("failing")));
run("stored module", () => keys(import("failing")));

// A statement that only calls import() must not leak in the compiler.
import("failing");
-- End --

-- File failing.uc --
export const a = 1;

if (global.fail)
	die("module body failed");

export const b = 2;
-- End --

-- Args --
-R -L files/
-- End --

-- Expect stdout --
failed load #1: module body failed
failed load #2: module body failed
good load: [ "a", "b" ]
stored module: [ "a", "b" ]
-- End --
